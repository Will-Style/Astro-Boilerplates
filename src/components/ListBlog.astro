---
export interface Props {
	title: string;
    image: string;
}

const { title='タイトルが入ります。タイトルが入ります。タイトルが入ります。', image='/assets/images/dummy.jpg' } = Astro.props;
---
 <article class="c-card c-card__blog" data-scroll-trigger="top">
    <a href="/blog/single/" class="c-card__overwrap__link">
        <div class="c-card__content">
            <h3 class="c-card__title">{title}</h3>
            <div class="c-card__details">
                <time class="c-card__time" aria-label="投稿日:">2026.07.05</time>
                <span class="c-card__cat">カテゴリー名カテゴリー名カテゴリー名カテゴリー名カテゴリー名</span>
            </div>
        </div>
        <figure class="c-card__figure" data-scroll-trigger='mask'><picture><img src={image}　alt="" class="c-card__image"></picture></figure>
    </a>
</article>